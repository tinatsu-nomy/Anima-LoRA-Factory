+def resolve_browser_path(root_name: str, relative_path: str = ""):
+    root_path = FILE_BROWSER_ROOTS.get(root_name)
+    if root_path is None:
+        raise HTTPException(status_code=400, detail="Unknown browser root")
+
+    root_path = root_path.resolve()
+    requested_path = (root_path / relative_path).resolve()
+    try:
+        requested_path.relative_to(root_path)
+    except ValueError:
+        raise HTTPException(status_code=403, detail="Path is outside the allowed root")
+
+    if not requested_path.is_dir():
+        raise HTTPException(status_code=404, detail="Directory not found")
+    return root_path, requested_path
+
+
+@app.get("/api/fs/list")
+async def list_browser_directory(root: str, path: str = ""):
+    root_path, current_path = resolve_browser_path(root, path)
+    entries = []
+    try:
+        children = sorted(
+            current_path.iterdir(),
+            key=lambda item: (not item.is_dir(), item.name.casefold()),
+        )
+        for item in children:
+            if item.name.startswith("."):
+                continue
+            resolved_item = item.resolve()
+            try:
+                resolved_item.relative_to(root_path)
+            except ValueError:
+                continue
+
+            is_directory = item.is_dir()
+            if not is_directory and (root != "models" or item.suffix.lower() != ".safetensors"):
+                continue
+            entries.append(
+                {
+                    "name": item.name,
+                    "is_dir": is_directory,
+                    "relative_path": resolved_item.relative_to(root_path).as_posix(),
+                    "container_path": resolved_item.as_posix(),
+                }
+            )
+    except PermissionError:
+        raise HTTPException(status_code=403, detail="Directory is not readable")
+
+    current_relative = current_path.relative_to(root_path).as_posix()
+    if current_relative == ".":
+        current_relative = ""
+    parent_relative = None
+    if current_path != root_path:
+        parent_relative = current_path.parent.relative_to(root_path).as_posix()
+        if parent_relative == ".":
+            parent_relative = ""
+
+    return {
+        "root": root,
+        "current_path": current_path.as_posix(),
+        "relative_path": current_relative,
+        "parent_relative_path": parent_relative,
+        "entries": entries,
+    }
 
