+const pathBrowserState = {
+    inputId: '',
+    root: '',
+    mode: 'file',
+    currentPath: '',
+    selectedPath: '',
+};
+
+async function openPathBrowser(inputId, root, mode, title) {
+    pathBrowserState.inputId = inputId;
+    pathBrowserState.root = root;
+    pathBrowserState.mode = mode;
+    pathBrowserState.currentPath = '';
+    pathBrowserState.selectedPath = '';
+    document.getElementById('path-browser-title').textContent = title;
+    const modal = document.getElementById('path-browser-modal');
+    modal.classList.add('open');
+    modal.setAttribute('aria-hidden', 'false');
+    await loadPathBrowserDirectory('');
+}
+
+async function loadPathBrowserDirectory(relativePath) {
+    const list = document.getElementById('path-browser-list');
+    const error = document.getElementById('path-browser-error');
+    const selectButton = document.getElementById('path-browser-select');
+    list.replaceChildren();
+    error.hidden = true;
+    list.textContent = '読み込み中... / Loading...';
+
+    try {
+        const params = new URLSearchParams({root: pathBrowserState.root, path: relativePath});
+        const response = await fetch(`/api/fs/list?${params}`);
+        if (!response.ok) {
+            const detail = await response.json();
+            throw new Error(detail.detail || `HTTP ${response.status}`);
+        }
+        const data = await response.json();
+        pathBrowserState.currentPath = data.current_path;
+        pathBrowserState.selectedPath = pathBrowserState.mode === 'directory' ? data.current_path : '';
+        document.getElementById('path-browser-current').textContent = data.current_path;
+        selectButton.disabled = pathBrowserState.mode === 'file';
+        list.replaceChildren();
+
+        if (data.parent_relative_path !== null) {
+            list.appendChild(createPathBrowserEntry('📁 ..', true, () => {
+                loadPathBrowserDirectory(data.parent_relative_path);
+            }));
+        }
+
+        for (const entry of data.entries) {
+            const label = `${entry.is_dir ? '📁' : '📄'} ${entry.name}`;
+            const row = createPathBrowserEntry(label, entry.is_dir, () => {
+                if (entry.is_dir) {
+                    loadPathBrowserDirectory(entry.relative_path);
+                } else {
+                    document.querySelectorAll('.path-browser-entry').forEach(item => item.classList.remove('selected'));
+                    row.classList.add('selected');
+                    pathBrowserState.selectedPath = entry.container_path;
+                    selectButton.disabled = false;
+                }
+            });
+            list.appendChild(row);
+        }
+
+        if (data.entries.length === 0) {
+            const empty = document.createElement('p');
+            empty.className = 'path-browser-empty';
+            empty.textContent = '選択可能な項目がありません / No selectable entries';
+            list.appendChild(empty);
+        }
+    } catch (exception) {
+        list.replaceChildren();
+        error.textContent = exception.message;
+        error.hidden = false;
+        selectButton.disabled = true;
+    }
+}
+
+function createPathBrowserEntry(label, isDirectory, handler) {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = `path-browser-entry${isDirectory ? ' directory' : ' file'}`;
+    button.textContent = label;
+    button.addEventListener('click', handler);
+    return button;
+}
+
+function confirmPathBrowserSelection() {
+    if (!pathBrowserState.selectedPath) return;
+    const input = document.getElementById(pathBrowserState.inputId);
+    input.value = pathBrowserState.selectedPath;
+    input.dispatchEvent(new Event('change', {bubbles: true}));
+    closePathBrowser();
+}
+
+function closePathBrowser() {
+    const modal = document.getElementById('path-browser-modal');
+    modal.classList.remove('open');
+    modal.setAttribute('aria-hidden', 'true');
+}
 
