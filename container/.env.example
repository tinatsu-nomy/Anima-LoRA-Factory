# Host directories. Relative paths are resolved from this container directory.
DATASET_DIR=./datasets
MODEL_DIR=./models
OUTPUT_DIR=./output
STATE_DIR=./state
APP_PORT=8000
HOST_UID=1000
HOST_GID=1000

# Pinned upstream archive. Update these three values together for a new release.
UPSTREAM_ARCHIVE=Anima-LoRA-Factory-v5.1.zip
UPSTREAM_DIRECTORY=Anima-LoRA-Factory-v5.1
UPSTREAM_SHA256=6d79ca7f7ecea0f3972605babc06ef91b97787625ea50a2fba7a7c1a9e6ccb8b

# Verified on NVIDIA RTX PRO 4000 Blackwell (sm_120).
# Override all four values together when using a different PyTorch/CUDA build.
CUDA_IMAGE=nvidia/cuda:12.8.0-runtime-ubuntu22.04
TORCH_SPEC=torch==2.11.0
TORCHVISION_SPEC=torchvision==0.26.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
